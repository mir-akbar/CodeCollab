# Railway Production Environment Variables
# Use Railway's reference variable syntax for dynamic configuration

# ==========================================
# BACKEND SERVICE CONFIGURATION
# ==========================================

# Database Configuration
# Use Railway's MongoDB service reference (if using Railway's MongoDB)
MONGODB_URI=${{MongoDB.DATABASE_URL}}
# Or use your own MongoDB Atlas URI
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/code_colab?retryWrites=true&w=majority
DB_NAME=code_colab

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS & Frontend Configuration
CORS_ORIGIN=${{Frontend.RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=${{Frontend.RAILWAY_PUBLIC_DOMAIN}}

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=your_production_pool_id
COGNITO_CLIENT_ID=your_production_client_id
COGNITO_REGION=your_aws_region

# Cookie Security for Production
COOKIE_SAME_SITE=strict

# ==========================================
# FRONTEND SERVICE CONFIGURATION  
# ==========================================

# Frontend Environment Variables (for Vite build)
VITE_AWS_COGNITO_USER_POOL_ID=your_production_pool_id
VITE_AWS_COGNITO_CLIENT_ID=your_production_client_id
VITE_AWS_REGION=your_aws_region

# API & WebSocket URLs using Railway reference variables
VITE_API_BASE_URL=https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}
VITE_WS_URL=wss://${{Backend.RAILWAY_PUBLIC_DOMAIN}}
VITE_NODE_ENV=production

# ==========================================
# OPTIONAL - TURN SERVERS (for video calling)
# ==========================================

# Only needed if video calling doesn't work with free STUN servers
# VITE_TURN_SERVER_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_PASSWORD=your_turn_password

# ==========================================
# RAILWAY DEPLOYMENT NOTES
# ==========================================

# 1. Railway automatically provides RAILWAY_PUBLIC_DOMAIN for each service
# 2. WebSockets work automatically over HTTPS (wss://) on Railway
# 3. No need for separate WebSocket ports - Railway handles this
# 4. Reference variables (${{Service.VARIABLE}}) are resolved at deploy time
# 5. Frontend and Backend should be separate Railway services
VITE_API_URL=${{Backend.RAILWAY_PUBLIC_DOMAIN}}
VITE_WS_URL=${{Backend.RAILWAY_PRIVATE_DOMAIN}}

# Authentication Configuration
VITE_AWS_COGNITO_USER_POOL_ID=us-east-1_example
VITE_AWS_COGNITO_CLIENT_ID=your_cognito_client_id
VITE_AWS_REGION=us-east-1

# Video Chat Configuration
VITE_VIDEO_ENABLED=true
# Free STUN servers for WebRTC
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Environment
NODE_ENV=production

# Build Configuration
VITE_BUILD_MODE=production
VITE_APP_VERSION=2.0.0

# ==========================================
# RAILWAY SPECIFIC NOTES
# ==========================================

# 1. Reference Variables:
#    Use ${{ServiceName.VARIABLE_NAME}} to reference variables from other services
#    Common Railway variables:
#    - RAILWAY_PUBLIC_DOMAIN: Public URL of the service
#    - RAILWAY_PRIVATE_DOMAIN: Private URL for internal communication
#    - DATABASE_URL: Auto-injected for database services

# 2. Secret Management:
#    - Store sensitive values like JWT secrets in Railway's secret management
#    - Never commit actual secrets to version control
#    - Use different secrets for different environments

# 3. Service Discovery:
#    - Use private networking between services to reduce costs and improve performance
#    - Only expose frontend and API gateway to the public network
#    - Internal services communicate over RAILWAY_PRIVATE_DOMAIN

# 4. Environment Separation:
#    - Use different Railway projects or environments for staging/production
#    - Configure different secrets and database instances per environment

# 5. Health Checks:
#    - Railway will automatically check /health endpoint
#    - Ensure your health check validates database connectivity
#    - Return 503 status for unhealthy services

# ==========================================
# RAILWAY DEPLOYMENT COMMANDS
# ==========================================

# Deploy backend service:
# railway up --service backend

# Deploy frontend service:  
# railway up --service frontend

# Set environment variables:
# railway variables set KEY=value --service backend

# View service logs:
# railway logs --service backend

# Check service status:
# railway status
