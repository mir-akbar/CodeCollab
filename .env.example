# Frontend Environment Variables (Vite)
# AWS Cognito Configuration
VITE_AWS_COGNITO_USER_POOL_ID=your_cognito_user_pool_id
VITE_AWS_COGNITO_CLIENT_ID=your_cognito_client_id
VITE_AWS_REGION=your_aws_region

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Environment
VITE_NODE_ENV=development

# Modular Session Service Configuration
USE_MODULAR_SESSION_SERVICE=true

# TURN Server Configuration (Optional - for video calling through NAT/firewalls)
# Only needed for production deployments where users are behind strict firewalls
# VITE_TURN_SERVER_URL=turn:your-turn-server.com:3478
# VITE_TURN_SERVER_URL_BACKUP=turn:backup-turn-server.com:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_PASSWORD=your_turn_password
